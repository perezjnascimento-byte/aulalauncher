<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="editar_aura"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_editar_aura"
        android:shortcutLongLabel="@string/shortcut_editar_aura">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="aura://settings"
            android:targetPackage="com.aura.launcher"
            android:targetClass="com.aura.launcher.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="fundo_aura"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_fundo"
        android:shortcutLongLabel="@string/shortcut_fundo">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="aura://fundo"
            android:targetPackage="com.aura.launcher"
            android:targetClass="com.aura.launcher.MainActivity" />
    </shortcut>
</shortcuts>
